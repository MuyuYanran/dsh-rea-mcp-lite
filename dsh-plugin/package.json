{
  "name": "dsh-rea-lite-panel",
  "version": "0.3.1",
  "description": "REA 工具网关的设置页：按功能分区勾选功能族、看清每个族的上下文成本、保存与读取命名预设、热切换，并能检查/应用本仓库与 REA 的更新、把新工具自动归类。",
  "license": "MIT",
  "author": "MuyuYanran",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuyuYanran/dsh-rea-mcp-lite.git",
    "directory": "dsh-plugin"
  },
  "homepage": "https://github.com/MuyuYanran/dsh-rea-mcp-lite#readme",
  "bugs": {
    "url": "https://github.com/MuyuYanran/dsh-rea-mcp-lite/issues"
  },
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.6-alpha.1 <0.3.0-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "gateway",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepack": "node scripts/pack-gateway.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "mcp",
    "rea",
    "rea-mcp-lite",
    "reverse-engineering",
    "progressive-disclosure"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.6-alpha.1 <0.2.0-0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "meta": {
    "title": "REA 工具网关",
    "description": "让 REA 的逆向工具按需加载：勾选功能族、看清 token 成本、约 1 秒热切换；并可检查更新、自动归类新工具。"
  }
}