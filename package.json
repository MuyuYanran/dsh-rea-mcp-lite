    "test:config": "node test/check-config.mjs",
    "snapshot": "node src/cli.mjs snapshot",
    "list": "node src/cli.mjs list",
    "status": "node src/cli.mjs status",
    "test:maintenance": "node test/maintenance.test.mjs",
    "check": "node src/cli.mjs check",
    "doctor": "node src/cli.mjs doctor",
    "classify": "node src/cli.mjs classify",
    "test:render": "node test/panel-render.test.mjs"
