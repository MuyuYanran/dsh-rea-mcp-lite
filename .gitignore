# 本机运行配置（含机器专属路径），不进版本库；模板见 config.example.json
config.json
config.json.tmp

# 备份
*.bak
*.bak-*

# probe/ 抓下来的大体积原始证据（体积大、可重新生成）
probe/*.jsonl
probe/client-index.js
probe/client-readme.md
probe/client-readme-zh.txt
probe/llm-deepseek.js

node_modules/

# e2e-check.mjs 自动生成的验收样本（确定性内容，需要时随时重建）
samples/

# 临时/废弃文件（含 pnpm 探测污染），不提交
.trash/
.rea-probe/

# npm 发包时由 dsh-plugin/scripts/pack-gateway.mjs 生成：网关副本 + 许可证副本。
# 唯一事实来源是仓库根的 src/ 与 LICENSE，这两份每次 pack 重新生成，不进版本库。
dsh-plugin/gateway/
dsh-plugin/LICENSE
# npm pack 的产物（发包时生成，不入库）
dsh-plugin/*.tgz
